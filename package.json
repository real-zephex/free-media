{
  "name": "streamify",
  "version": "0.1.0",
  "private": true,
  "description": "A premium movie and TV show streaming desktop client",
  "author": "Dramaflix Team <support@dramaflix.com>",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "electron:dev": "concurrently -k -s first \"bun run dev\" \"wait-on http://localhost:3000 && electron . --dev\"",
    "electron:build": "bun run build && electron-builder"
  },
  "dependencies": {
    "@next/third-parties": "^16.4.2",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.576.0",
    "next": "^16.4.2",
    "nextjs-toploader": "^3.9.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hotkeys-hook": "^5.3.3",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "electron": "^42.11.15",
    "electron-builder": "^26.15.3",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.dramaflix.desktop",
    "productName": "Dramaflix",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "package.json",
      "electron/**/*",
      ".next/**/*",
      "public/**/*",
      "next.config.mjs"
    ],
    "asar": true,
    "asarUnpack": [
      ".next/**/*",
      "public/**/*",
      "next.config.mjs",
      "node_modules/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Video",
      "maintainer": "Dramaflix Team <support@dramaflix.com>"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.entertainment"
    }
  }
}
